# Database Configurations
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=sportshoe;encrypt=true;trustServerCertificate=true;sendUnicodeParameters=true;

DB_USERNAME=sa
DB_PASSWORD=YourPassword123

# Mail Configurations
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Payment Services
GHN_TOKEN=your-ghn-token
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost/payment-callback
SEPAY_API_KEY=your-sepay-api-key
SEPAY_BANK=your-bank-name
SEPAY_ACCOUNT_NUMBER=your-bank-account
SEPAY_ACCOUNT_NAME=your-account-name

# ==========================================
# AI Chatbot Configurations (Điền 1 trong các key dưới đây)
# ==========================================
# Cấu hình API Key cho OpenAI (Nếu dùng GPT-4o-mini)
OPENAI_API_KEY=

# Cấu hình API Key cho Google Gemini (Nếu dùng gemini-1.5-flash)
GEMINI_API_KEY=

# Cấu hình API Key cho DeepSeek (Nếu dùng deepseek-chat)
DEEPSEEK_API_KEY=

# Cấu hình API Key cho Groq (Nếu dùng llama-3.3-70b-versatile)
GROQ_API_KEY=

# Ollama local fallback. Trong Docker, backend gọi service tên "ollama".
AI_LOCAL_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_REQUEST_TIMEOUT_SECONDS=180
AI_LOCAL_MAX_CONCURRENT=1
AI_LOCAL_QUEUE_WAIT_SECONDS=5

