# ========================================================
# CẤU HÌNH DOCKER CHO DỰ ÁN SPORTSHOE STORE
# ========================================================

# Tùy chọn tên image
DOCKER_USERNAME=sportshoe

# Port cấu hình
FRONTEND_PORT=80
BACKEND_PORT=8080
DB_PORT=1433

# Cấu hình Mật khẩu Database SQL Server (SA)
DB_PASSWORD=MatKhauDatabaseCuaBan123!

# Cấu hình Gửi Mail SMTP (Gmail App Password nếu có)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cấu hình Giao Hàng Nhanh (GHN)
GHN_TOKEN=
GHN_SHOP_ID=0
GHN_FROM_DISTRICT_ID=0
GHN_FROM_WARD_CODE=

# Cấu hình VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=
VNPAY_RETURN_URL=

# Cấu hình SePay (Chuyển khoản ngân hàng tự động)
SEPAY_API_KEY=
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# AI cloud (tùy chọn). Khi các provider này lỗi hoặc không có key, hệ thống dùng Ollama.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# AI local fallback chạy trong Docker Compose.
AI_LOCAL_FALLBACK_ENABLED=true
OLLAMA_TEXT_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_KEEP_ALIVE=10m
# Timeout sinh phản hồi của Ollama local: 5 giờ = 18.000 giây
AI_REQUEST_TIMEOUT_SECONDS=18000
AI_CLOUD_REQUEST_TIMEOUT_SECONDS=5
AI_LOCAL_MAX_CONCURRENT=1
AI_LOCAL_QUEUE_WAIT_SECONDS=5
# Tùy chọn: tái sử dụng thư mục model có sẵn trên host.
# OLLAMA_MODELS_PATH=D:/TienDich/models/ollama
